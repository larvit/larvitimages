{
	"compileOnSave": true,
	"compilerOptions": {
		"allowJs": false,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"module": "CommonJS",
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"types": ["*"],
		"preserveSymlinks": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "es2020"
	},
	"include": [
		"src/**/*.ts"
	],
	"ts-node": {
		"files": true,
		"compilerOptions": {
			"rootDir": "."
		}
	}
}
